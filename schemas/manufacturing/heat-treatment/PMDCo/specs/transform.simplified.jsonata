(
  /*
   * Heat Treatment (PMDCo): simplified JSON -> OO-LD JSON
   *
   * Input fields:
   *   process_name        string   required
   *   heat_treatment_type string   required -- one of the HeatTreatmentType enum values
   *   process_id          string   optional, derived from process_name if omitted
   *   description         string   optional
   *   inputs              array    optional: each item is a specimen/material IRI string
   *   outputs             array    optional: each item is a specimen IRI string
   *   preceded_by         array    optional: each item is a process IRI string
   *   process_attributes  array    optional
   *     name              string   required -- must match parameter_label enum or use free text
   *     value             number   optional (quantitative parameters)
   *               OR      string   optional (qualitative parameters: atmosphere, cooling medium,
   *                                furnace type). Compound label built as "name: value" in RDF.
   *     unit              string   optional -- SI symbol ("degC", "h", ...) or uqudt: CURIE
   *     type_iri          string   optional -- override auto-derived parameter_type IRI
   *
   * SDK usage: no need to supply type_iri -- the transform auto-injects it from the
   * parameter name using $paramTypeMap. Pass only name/value(/unit).
   *
   * Qualitative parameters -- pass name as category, value as string:
   *   {"name": "Atmosphere",     "value": "Argon"}
   *   {"name": "Cooling Medium", "value": "Water Quench"}
   *   {"name": "Furnace Type",   "value": "Recirculating Air Furnace"}
   */

  $schemaUri := "https://raw.githubusercontent.com/semantic-dataspace/semantic-schemas/kiran/schemas/manufacturing/heat-treatment/PMDCo/specs/schema.oold.yaml";

  /* -- Heat treatment subtype -> dsmsht: class IRI ---------------------------------- */
  $htTypeMap := {
    "Solution Treatment":          "dsmsht:SolutionTreatment",
    "Artificial Aging":            "dsmsht:ArtificialAging",
    "Natural Aging":               "dsmsht:NaturalAging",
    "Full Annealing":              "dsmsht:FullAnnealing",
    "Partial Annealing":           "dsmsht:PartialAnnealing",
    "Recrystallization Annealing": "dsmsht:RecrystallizationAnnealing",
    "Stress Relief Annealing":     "dsmsht:StressReliefAnnealing",
    "Normalizing":                 "dsmsht:Normalizing",
    "Tempering":                   "dsmsht:Tempering",
    "Homogenization":              "dsmsht:Homogenization",
    "Quenching":                   "dsmsht:Quenching"
  };

  /* -- Parameter label -> dsmsht: class IRI ---------------------------------------- */
  /* Auto-derived: SDK users pass only name/value(/unit). No type_iri needed.          */
  /* Qualitative category names map to their semantic class.                           */
  $paramTypeMap := {
    /* Temperatures */
    "Solutionising Temperature":  "dsmsht:SolutionisationTemperature",
    "Aging Temperature":          "dsmsht:AgingTemperature",
    "Annealing Temperature":      "dsmsht:AnnealingTemperature",
    "Normalizing Temperature":    "dsmsht:NormalizingTemperature",
    "Tempering Temperature":      "dsmsht:TemperingTemperature",
    "Homogenization Temperature": "dsmsht:HomogenizationTemperature",
    /* Times */
    "Hold Time":                  "dsmsht:HoldTime",
    "Aging Time":                 "dsmsht:AgingTime",
    "Tempering Time":             "dsmsht:TemperingTime",
    "Homogenization Time":        "dsmsht:HomogenizationTime",
    /* Rates */
    "Heating Rate":               "dsmsht:HeatingRate",
    "Cooling Rate":               "dsmsht:CoolingRate",
    /* Delays */
    "Quench Delay":               "dsmsht:QuenchDelay",
    /* Qualitative categories -- value supplied separately as a string */
    "Atmosphere":                 "dsmsht:Atmosphere",
    "Cooling Medium":             "dsmsht:CoolingMedium",
    "Furnace Type":               "dsmsht:FurnaceType"
  };

  /* -- Unit label -> QUDT unit CURIE ----------------------------------------------- */
  $unitMap := {
    "°C":    "uqudt:DEG_C",
    "degC":  "uqudt:DEG_C",
    "K":      "uqudt:K",
    "h":      "uqudt:HR",
    "min":    "uqudt:MIN",
    "s":      "uqudt:SEC",
    "C/min":  "uqudt:K-PER-MIN",
    "K/min":  "uqudt:K-PER-MIN",
    "K/s":    "uqudt:K-PER-SEC"
  };

  /* -- Node IDs --------------------------------------------------------------------- */
  $slug   := $replace($lowercase($trim(process_name)), /[^a-z0-9]+/, "-");
  $procId := $exists(process_id) ? process_id : "process-" & $slug;

  /* -- Process subtype IRI ---------------------------------------------------------- */
  $htTypeIri := $exists(heat_treatment_type) ? $lookup($htTypeMap, heat_treatment_type) : undefined;

  /* -- Process attributes ----------------------------------------------------------- */
  $attrs := $exists(process_attributes) and $count(process_attributes) > 0
    ? $map(process_attributes, function($p, $i) {(
        /* Detect qualitative: value is a non-empty string */
        $isQualitative := $exists($p.value) and $type($p.value) = "string";

        /* Base node — parameter_label always stores the category/name only */
        $node := {
          "type": ["pmdco:PMD_0000013"],
          "id":   $procId & "-param-" & $string($i + 1),
          "parameter_label": $p.name
        };

        /* parameter_type: explicit type_iri overrides auto-lookup from name (category) */
        $resolvedTypeIri := $exists($p.type_iri) ? $p.type_iri : $lookup($paramTypeMap, $p.name);
        $withType := $exists($resolvedTypeIri)
          ? $merge([$node, {"parameter_type": $resolvedTypeIri}])
          : $node;

        /* qualitative_value: string value for atmosphere/cooling medium/furnace type */
        $withQualValue := $isQualitative
          ? $merge([$withType, {"qualitative_value": $p.value}])
          : $withType;

        /* parameter_value: numeric parameters only */
        $numericValue := $exists($p.value) and $type($p.value) = "number" ? $p.value : undefined;
        $withValue := $exists($numericValue)
          ? $merge([$withQualValue, {"parameter_value": $numericValue}])
          : $withQualValue;

        /* parameter_unit: resolve SI label to QUDT CURIE; pass through if already CURIE */
        $resolvedUnit := $exists($p.unit)
          ? ($lookup($unitMap, $p.unit) != null ? $lookup($unitMap, $p.unit) : $p.unit)
          : undefined;
        $exists($resolvedUnit)
          ? $merge([$withValue, {"parameter_unit": $resolvedUnit}])
          : $withValue
      )})
    : undefined;

  /* -- OO-LD output ----------------------------------------------------------------- */
  $base := {
    "conforms_to": $schemaUri,
    "type":  $exists($htTypeIri) ? ["pmdco:PMD_0000833", $htTypeIri] : ["pmdco:PMD_0000833"],
    "id":    $procId,
    "label": process_name,
    "heat_treatment_type": heat_treatment_type
  };

  $withDesc := $exists(description)
    ? $merge([$base, {"description": description}])
    : $base;

  $withInputs := $exists(inputs) and $count(inputs) > 0
    ? $merge([$withDesc, {"has_specified_input": inputs}])
    : $withDesc;

  $withOutputs := $exists(outputs) and $count(outputs) > 0
    ? $merge([$withInputs, {"has_specified_output": outputs}])
    : $withInputs;

  $withPreceded := $exists(preceded_by) and $count(preceded_by) > 0
    ? $merge([$withOutputs, {"preceded_by": preceded_by}])
    : $withOutputs;

  $exists($attrs)
    ? $merge([$withPreceded, {"has_process_attribute": $attrs}])
    : $withPreceded
)
