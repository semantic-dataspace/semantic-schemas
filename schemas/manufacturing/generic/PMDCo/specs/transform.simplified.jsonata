(
  /*
   * Manufacturing Generic (PMDCo): simplified JSON → OO-LD JSON
   *
   * Input fields (see schema.simplified.json):
   *   process_name        string   required
   *   process_id          string   optional, derived from process_name if omitted
   *   description         string   optional
   *   inputs              array    optional: each item is a material/KItem IRI string
   *   outputs             array    optional: each item is a material/KItem IRI string
   *   preceded_by         array    optional: each item is a process IRI string
   *   process_attributes  array    optional
   *     name              string   required
   *     value             number   optional
   *     unit              string   optional — vocabulary label ("Degree Celsius (°C)") or full IRI
   *     type              string   optional — parameter type: vocabulary label or full IRI
   *                                           (type_iri accepted as alias for backward compat)
   *
   * Run with the jsonata-python CLI:
   *   python -m jsonata -e transform.jsonata -i ../docs/example.input.json
   */

  /*
   * Schema provenance: injected automatically into every output.
   * Update $schemaUri whenever x-schema-version in specs/schema.oold.yaml changes.
   */
  $schemaUri := "https://raw.githubusercontent.com/semantic-dataspace/semantic-schemas/manufacturing-generic-PMDCo-v0.2.1/schemas/manufacturing/generic/PMDCo/specs/schema.oold.generated.json";

  /* ── Node IDs ────────────────────────────────────────────────────────────── */
  $slug   := $replace($lowercase($trim(process_name)), /[^a-z0-9]+/, "-");
  $procId := $exists(process_id) ? process_id : "process-" & $slug;

  /* ── Process attributes (pmdco:PMD_0000009 → ParameterSpecification nodes) */
  $attrs := $exists(process_attributes) and $count(process_attributes) > 0
    ? $map(process_attributes, function($p, $i) {(
        $node := {
          "type": ["pmdco:PMD_0000013"],
          "id":   $procId & "-param-" & $string($i + 1),
          "parameter_label": $p.name
        };
        $resolvedType := $exists($p.type_iri) ? $p.type_iri : ($exists($p.type) ? $p.type : undefined);
        $withType  := $exists($resolvedType)  ? $merge([$node,      {"parameter_type":  $resolvedType}]) : $node;
        $withValue := $exists($p.value)       ? $merge([$withType,  {"parameter_value": $p.value}])      : $withType;
        $exists($p.unit) ? $merge([$withValue, {"parameter_unit": $p.unit}]) : $withValue
      )})
    : undefined;

  /* ── OO-LD output ────────────────────────────────────────────────────────── */
  $base := {
    "conforms_to": $schemaUri,
    "type":        ["pmdco:PMD_0000833"],
    "id":          $procId,
    "label":       process_name
  };

  $withDesc := $exists(description)
    ? $merge([$base, {"description": description}])
    : $base;

  $withInputs := $exists(inputs) and $count(inputs) > 0
    ? $merge([$withDesc, {"has_specified_input": inputs}])
    : $withDesc;

  $withOutputs := $exists(outputs) and $count(outputs) > 0
    ? $merge([$withInputs, {"has_specified_output": outputs}])
    : $withInputs;

  $withPreceded := $exists(preceded_by) and $count(preceded_by) > 0
    ? $merge([$withOutputs, {"preceded_by": preceded_by}])
    : $withOutputs;

  $exists($attrs)
    ? $merge([$withPreceded, {"has_process_attribute": $attrs}])
    : $withPreceded
)
