(
  /*
   * Unit Process Inventory (PMDCo / UPLCI): simplified JSON → OO-LD JSON
   *
   * Input (see schema.simplified.json):
   *   inventory_name*, inventory_id, description, process (IRI), geography*,
   *   site, date_compiled, valid_until, access_rights* (public|restricted|confidential),
   *   trl, data_generators[IRI], data_owner (IRI), reviewers[IRI], source,
   *   inputs[]  / outputs[]  : exchange objects
   *     name*, category*, value*, unit*, flow_object, material, description,
   *     data_source, source_note, scaling_slope, scaling_base,
   *     provider (IRI), background_provider{database*, activity_name*, …},
   *     properties[]{type*, value*, unit, currency, name, data_source, source_note},
   *     is_reference_flow (outputs only)
   *   parameters[] : name*, category*, parameter_type, value, unit, description,
   *                  scalable, data_source, source_note
   *
   * Short keywords (e.g. category "energy", unit "kWh", data_source "measured")
   * are mapped to IRIs/CURIEs below.  Any value that is not a known keyword is
   * passed through unchanged, so full IRIs, CURIEs and vocabulary labels work
   * too (labels are resolved later by Schema.resolve_vocabulary()).
   */

  $schemaUri := "https://raw.githubusercontent.com/semantic-dataspace/semantic-schemas/life-cycle-assessment-unit-process-inventory-PMDCo-v0.1.0/schemas/life-cycle-assessment/unit-process-inventory/PMDCo/specs/schema.oold.generated.json";

  /* ── keyword → IRI maps ───────────────────────────────────────────────── */
  $inputCategory := {
    "material":         "uplci:MaterialInput",
    "energy":           "uplci:EnergyInput",
    "personnel":        "uplci:PersonnelInput",
    "service":          "uplci:ServiceInput",
    "natural_resource": "uplci:NaturalResourceInput"
  };
  $outputCategory := {
    "product":    "uplci:ProductOutput",
    "co_product": "uplci:CoProductOutput",
    "waste":      "uplci:WasteOutput",
    "emission":   "uplci:EmissionOutput",
    "other":      "uplci:OtherOutput"
  };
  $derivation := {
    "measured":   "uplci:Measured",
    "calculated": "uplci:Calculated",
    "estimated":  "uplci:Estimated",
    "assumption": "uplci:Assumed",
    "literature": "uplci:FromLiterature",
    "setting":    "uplci:MachineSetting",
    "unknown":    "uplci:UnknownDerivation"
  };
  $parameterCategory := {
    "facility":  "uplci:FacilityParameter",
    "process":   "uplci:ProcessParameter",
    "operation": "uplci:OperationParameter"
  };
  $propertyType := {
    "monetary_value": "uplci:MonetaryValuePerUnit",
    "climate_change": "uplci:ClimateChangePerUnit",
    "other":          "uplci:OtherFlowProperty"
  };
  $accessRights := {
    "public":       "accr:PUBLIC",
    "restricted":   "accr:RESTRICTED",
    "confidential": "accr:NON_PUBLIC"
  };
  $database := {
    "ecoinvent-3.8-cutoff":          "uplci:Ecoinvent_3_8_Cutoff",
    "ecoinvent-3.8-apos":            "uplci:Ecoinvent_3_8_APOS",
    "ecoinvent-3.8-consequential":   "uplci:Ecoinvent_3_8_Consequential",
    "ecoinvent-3.9.1-cutoff":        "uplci:Ecoinvent_3_9_1_Cutoff",
    "ecoinvent-3.9.1-apos":          "uplci:Ecoinvent_3_9_1_APOS",
    "ecoinvent-3.9.1-consequential": "uplci:Ecoinvent_3_9_1_Consequential",
    "ecoinvent-3.10-cutoff":         "uplci:Ecoinvent_3_10_Cutoff",
    "ecoinvent-3.10-apos":           "uplci:Ecoinvent_3_10_APOS",
    "ecoinvent-3.10-consequential":  "uplci:Ecoinvent_3_10_Consequential"
  };
  /* common unit symbols → QUDT */
  $unitSymbol := {
    "kg": "uqudt:KiloGM", "g": "uqudt:GM", "mg": "uqudt:MilliGM", "t": "uqudt:TON",
    "kWh": "uqudt:KiloW-HR", "MWh": "uqudt:MegaW-HR", "MJ": "uqudt:MegaJ", "GJ": "uqudt:GigaJ",
    "kJ": "uqudt:KiloJ", "J": "uqudt:J",
    "m3": "uqudt:M3", "m^3": "uqudt:M3", "l": "uqudt:L", "L": "uqudt:L", "ml": "uqudt:MilliL",
    "m2": "uqudt:M2", "m^2": "uqudt:M2", "m²": "uqudt:M2", "cm2": "uqudt:CentiM2", "cm^2": "uqudt:CentiM2",
    "m": "uqudt:M", "cm": "uqudt:CentiM", "mm": "uqudt:MilliM",
    "h": "uqudt:HR", "min": "uqudt:MIN", "s": "uqudt:SEC", "d": "uqudt:DAY", "a": "uqudt:YR",
    "piece": "uqudt:NUM", "item": "uqudt:NUM", "pcs": "uqudt:NUM",
    "%": "uqudt:PERCENT",
    "kg/h": "uqudt:KiloGM-PER-HR", "l/h": "uqudt:L-PER-HR", "m3/h": "uqudt:M3-PER-HR",
    "kg/m3": "uqudt:KiloGM-PER-M3", "kg/m^3": "uqudt:KiloGM-PER-M3", "kg/m": "uqudt:KiloGM-PER-M",
    "°C": "uqudt:DEG_C", "K": "uqudt:K", "bar": "uqudt:BAR", "MPa": "uqudt:MegaPA"
  };

  $map1 := function($value, $table) {
    $exists($value) ? ($exists($lookup($table, $value)) ? $lookup($table, $value) : $value) : undefined
  };
  $pad2 := function($i) { $pad($string($i + 1), -2, "0") };
  $slug := function($s) { $replace($lowercase($trim($s)), /[^a-z0-9]+/, "-") };

  $inventoryId := $exists(inventory_id) ? inventory_id : "upi-" & $slug(inventory_name);

  $valueSpec := function($id, $value, $unit) {
    {
      "type":          ["obo:OBI_0001931"],
      "id":            $id,
      "numeric_value": $value,
      "unit":          $map1($unit, $unitSymbol)
    }
  };

  $flowProperty := function($p, $j, $exchangeId) {(
    $pid := $exchangeId & "-property-" & $pad2($j);
    {
      "type":            ["uplci:FlowPropertyDatum"],
      "id":              $pid,
      "label":           $p.name,
      "property_type":   $map1($p.type, $propertyType),
      "property_value":  $valueSpec($pid & "-value", $p.value, $p.unit),
      "currency":        $p.currency,
      "data_derivation": $map1($p.data_source, $derivation),
      "source_note":     $p.source_note
    }
  )};

  $backgroundProvider := function($b, $exchangeId) {
    $exists($b) ? {
      "type":              ["uplci:BackgroundDatasetReference"],
      "id":                $exchangeId & "-background-provider",
      "database":          $map1($b.database, $database),
      "label":             $b.activity_name,
      "reference_product": $b.reference_product,
      "geography":         $b.geography,
      "unit":              $map1($b.unit, $unitSymbol),
      "dataset_uuid":      $b.uuid
    } : undefined
  };

  $exchange := function($e, $i, $direction, $categories) {(
    $eid := $inventoryId & "-" & $direction & "-" & $pad2($i);
    {
      "type":                ["uplci:Exchange"],
      "id":                  $eid,
      "label":               $e.name,
      "category":            $map1($e.category, $categories),
      "flow_object":         $e.flow_object,
      "material":            $e.material,
      "amount":              $valueSpec($eid & "-amount", $e.value, $e.unit),
      "is_reference_flow":   $e.is_reference_flow = true ? true : undefined,
      "description":         $e.description,
      "scaling_slope":       $e.scaling_slope,
      "scaling_base":        $e.scaling_base,
      "data_derivation":     $map1($e.data_source, $derivation),
      "source_note":         $e.source_note,
      "provider":            $e.provider,
      "background_provider": $backgroundProvider($e.background_provider, $eid),
      "properties":          $exists($e.properties)
                               ? [$map($e.properties, function($p, $j) { $flowProperty($p, $j, $eid) })]
                               : undefined
    }
  )};

  $parameter := function($p, $i) {
    {
      "type":               ["pmdco:PMD_0000013"],
      "id":                 $inventoryId & "-param-" & $pad2($i),
      "parameter_label":    $p.name,
      "parameter_type":     $p.parameter_type,
      "parameter_category": $map1($p.category, $parameterCategory),
      "parameter_value":    $p.value,
      "parameter_unit":     $map1($p.unit, $unitSymbol),
      "is_scalable":        $p.scalable,
      "description":        $p.description,
      "data_derivation":    $map1($p.data_source, $derivation),
      "source_note":        $p.source_note
    }
  };

  /* ── OO-LD output ────────────────────────────────────────────────────── */
  {
    "conforms_to":                $schemaUri,
    "type":                       ["uplci:UnitProcessInventory"],
    "id":                         $inventoryId,
    "label":                      inventory_name,
    "description":                description,
    "describes_process":          process,
    "geography":                  geography,
    "site":                       site,
    "date_compiled":              date_compiled,
    "valid_until":                $exists(valid_until) ? $string(valid_until) : undefined,
    "access_rights":              $map1(access_rights, $accessRights),
    "technology_readiness_level": trl,
    "creator":                    data_generators,
    "publisher":                  data_owner,
    "reviewer":                   reviewers,
    "source":                     source,
    "inputs":                     [$map(inputs,  function($e, $i) { $exchange($e, $i, "in",  $inputCategory)  })],
    "outputs":                    [$map(outputs, function($e, $i) { $exchange($e, $i, "out", $outputCategory) })],
    "technology_parameters":      [$map(parameters, $parameter)]
  }
)
