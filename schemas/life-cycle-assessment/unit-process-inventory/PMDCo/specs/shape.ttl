# SHACL shape for the Unit Process Inventory (UPLCI) schema.
#
# Validates:
#   1. UnitProcessInventory
#      - label, conformsTo, geography, access rights (closed list) present
#      - at least one output; exactly one reference flow, and it is a product/co-product
#      - input exchanges carry input categories, output exchanges output categories
#      - TRL within 1..9; dates typed
#      - WARNING if the inventory is not linked to the process it describes
#   2. Exchange
#      - name, category, exactly one amount (value + QUDT unit)
#      - unit plausible for the category (energy → energy units, material → mass/volume/count …)
#      - a foreground and a background provider are not both given
#      - WARNING if data derivation is missing
#   3. Flow property, background provider, technology parameter nodes
#
# Shared PMDCo/OBI classes (OBI_0001931, PMD_0000013) are validated via sh:node
# from the owning node, not via sh:targetClass, so these shapes never interfere
# with other schemas that reuse the same classes.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix pmd:     <https://w3id.org/pmd/co/> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix uqudt:   <http://qudt.org/vocab/unit/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix uplci:   <https://w3id.org/dsms/uplci#> .
@prefix accr:    <http://publications.europa.eu/resource/authority/access-right/> .
@prefix shape:   <https://w3id.org/dsms/shapes/life-cycle-assessment/unit-process-inventory/> .

# ── SPARQL prefix declarations ───────────────────────────────────────────────

shape:prefixes
    a owl:Ontology ;
    sh:declare
        [ sh:prefix "uplci" ; sh:namespace "https://w3id.org/dsms/uplci#"^^xsd:anyURI ] ,
        [ sh:prefix "obo"   ; sh:namespace "http://purl.obolibrary.org/obo/"^^xsd:anyURI ] ,
        [ sh:prefix "uqudt" ; sh:namespace "http://qudt.org/vocab/unit/"^^xsd:anyURI ] .

# ── Unit process inventory ────────────────────────────────────────────────────

shape:unit_process_inventory
    a sh:NodeShape ;
    sh:targetClass uplci:UnitProcessInventory ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An inventory must declare dcterms:conformsTo pointing to the versioned schema IRI." ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An inventory must have exactly one name (rdfs:label)." ;
    ] ;
    sh:property [
        sh:path uplci:geography ;
        sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ; sh:minLength 2 ;
        sh:message "An inventory must state its geography (ISO country code or ecoinvent region)." ;
    ] ;
    sh:property [
        sh:path dcterms:accessRights ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( accr:PUBLIC accr:RESTRICTED accr:NON_PUBLIC ) ;
        sh:message "Access rights must be PUBLIC, RESTRICTED or NON_PUBLIC (EU access-right vocabulary)." ;
    ] ;
    sh:property [
        sh:path dcterms:created ;
        sh:datatype xsd:date ; sh:maxCount 1 ;
        sh:message "Date of compilation must be a single xsd:date." ;
    ] ;
    sh:property [
        sh:path dcterms:valid ;
        sh:datatype xsd:gYear ; sh:maxCount 1 ;
        sh:message "Valid-until must be a single year (xsd:gYear)." ;
    ] ;
    sh:property [
        sh:path uplci:technologyReadinessLevel ;
        sh:datatype xsd:integer ; sh:maxCount 1 ;
        sh:minInclusive 1 ; sh:maxInclusive 9 ;
        sh:message "TRL must be an integer between 1 and 9." ;
    ] ;
    sh:property [
        sh:path obo:IAO_0000136 ;
        sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "The inventory should be linked to exactly one manufacturing process it describes (is about)." ;
    ] ;
    sh:property [
        sh:path dcterms:creator ; sh:nodeKind sh:IRI ;
        sh:message "Data generators must be referenced by IRI." ;
    ] ;
    sh:property [
        sh:path dcterms:publisher ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:message "Data owner must be a single organisation IRI." ;
    ] ;
    sh:property [
        sh:path uplci:hasInput ;
        sh:class uplci:Exchange ;
        sh:message "Inputs must be uplci:Exchange nodes (validated by shape:exchange)." ;
    ] ;
    sh:property [
        sh:path uplci:hasOutput ;
        sh:minCount 1 ;
        sh:class uplci:Exchange ;
        sh:message "An inventory must have at least one output exchange." ;
    ] ;
    sh:property [
        sh:path ( uplci:hasInput uplci:hasExchangeCategory ) ;
        sh:in ( uplci:MaterialInput uplci:EnergyInput uplci:PersonnelInput uplci:ServiceInput uplci:NaturalResourceInput ) ;
        sh:message "Input exchanges must use an input category (material, energy, personnel, service, natural resource)." ;
    ] ;
    sh:property [
        sh:path ( uplci:hasOutput uplci:hasExchangeCategory ) ;
        sh:in ( uplci:ProductOutput uplci:CoProductOutput uplci:WasteOutput uplci:EmissionOutput uplci:OtherOutput ) ;
        sh:message "Output exchanges must use an output category (product, co-product, waste, emission, other)." ;
    ] ;
    sh:property [
        sh:path ( uplci:hasInput uplci:isReferenceFlow ) ;
        sh:not [ sh:hasValue true ] ;
        sh:message "An input cannot be the reference flow." ;
    ] ;
    sh:property [
        sh:path uplci:hasOutput ;
        sh:qualifiedValueShape [
            sh:property [ sh:path uplci:isReferenceFlow ; sh:hasValue true ] ;
            sh:property [ sh:path uplci:hasExchangeCategory ; sh:in ( uplci:ProductOutput uplci:CoProductOutput ) ] ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:qualifiedMaxCount 1 ;
        sh:message "Exactly one output must be flagged as reference flow, and it must be a product or co-product output." ;
    ] ;
    sh:property [
        sh:path uplci:hasTechnologyParameter ;
        sh:node shape:technology_parameter ;
    ] ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) .

# ── Exchange ──────────────────────────────────────────────────────────────────

shape:exchange
    a sh:NodeShape ;
    sh:targetClass uplci:Exchange ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An exchange must have exactly one flow name." ;
    ] ;
    sh:property [
        sh:path uplci:hasExchangeCategory ;
        sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An exchange must have exactly one category." ;
    ] ;
    sh:property [
        sh:path obo:OBI_0001938 ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:node shape:amount ;
        sh:message "An exchange must have exactly one amount (value specification with value and unit)." ;
    ] ;
    sh:property [
        sh:path uplci:hasFlowObject ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:message "Flow type must be a single vocabulary IRI." ;
    ] ;
    sh:property [
        sh:path obo:IAO_0000136 ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:message "Material must be a single KItem IRI." ;
    ] ;
    sh:property [
        sh:path uplci:isReferenceFlow ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path uplci:scalingSlope ; sh:datatype xsd:double ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path uplci:scalingBase ; sh:datatype xsd:double ; sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path uplci:hasDataDerivation ;
        sh:maxCount 1 ;
        sh:in ( uplci:Measured uplci:Calculated uplci:Estimated uplci:Assumed uplci:FromLiterature uplci:MachineSetting uplci:UnknownDerivation ) ;
        sh:message "Data derivation must be one of measured, calculated, estimated, assumption, literature, machine setting, unknown." ;
    ] ;
    sh:property [
        sh:path uplci:hasDataDerivation ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "State how the amount was derived (measured, calculated, estimated, …)." ;
    ] ;
    sh:property [
        sh:path uplci:hasProvider ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:message "Foreground provider must be a single inventory IRI." ;
    ] ;
    sh:property [
        sh:path uplci:hasBackgroundProvider ; sh:maxCount 1 ;
        sh:node shape:background_provider ;
    ] ;
    sh:property [
        sh:path uplci:hasFlowProperty ;
        sh:node shape:flow_property ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Exchange has both a foreground and a background provider; choose one." ;
        sh:prefixes shape:prefixes ;
        sh:select """
            SELECT $this WHERE {
                $this uplci:hasProvider ?fg ;
                      uplci:hasBackgroundProvider ?bg .
            }""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Unit {?unit} is not an energy unit, but the exchange is an energy input (expected kWh, MWh, MJ, GJ, kJ, J)." ;
        sh:prefixes shape:prefixes ;
        sh:select """
            SELECT $this ?unit WHERE {
                $this uplci:hasExchangeCategory uplci:EnergyInput ;
                      obo:OBI_0001938/obo:IAO_0000039 ?unit .
                FILTER (?unit NOT IN (uqudt:KiloW-HR, uqudt:MegaW-HR, uqudt:W-HR,
                                      uqudt:MegaJ, uqudt:GigaJ, uqudt:KiloJ, uqudt:J))
            }""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Unit {?unit} is not a mass, volume, area or count unit, but the exchange is a material, waste or emission flow." ;
        sh:prefixes shape:prefixes ;
        sh:select """
            SELECT $this ?unit WHERE {
                $this uplci:hasExchangeCategory ?category ;
                      obo:OBI_0001938/obo:IAO_0000039 ?unit .
                FILTER (?category IN (uplci:MaterialInput, uplci:WasteOutput,
                                      uplci:EmissionOutput, uplci:NaturalResourceInput))
                FILTER (?unit NOT IN (uqudt:KiloGM, uqudt:GM, uqudt:MilliGM, uqudt:TON,
                                      uqudt:M3, uqudt:L, uqudt:MilliL,
                                      uqudt:M2, uqudt:CentiM2, uqudt:M, uqudt:NUM))
            }""" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Unit {?unit} is not a time unit, but the exchange is a personnel input (expected h, d, a)." ;
        sh:prefixes shape:prefixes ;
        sh:select """
            SELECT $this ?unit WHERE {
                $this uplci:hasExchangeCategory uplci:PersonnelInput ;
                      obo:OBI_0001938/obo:IAO_0000039 ?unit .
                FILTER (?unit NOT IN (uqudt:HR, uqudt:DAY, uqudt:YR, uqudt:MIN))
            }""" ;
    ] ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) .

# ── Amount (scalar value specification, unit mandatory) ───────────────────────

shape:amount
    a sh:NodeShape ;
    sh:class obo:OBI_0001931 ;
    sh:property [
        sh:path obo:OBI_0001937 ;
        sh:datatype xsd:double ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An amount must have exactly one numeric value (xsd:double)." ;
    ] ;
    sh:property [
        sh:path obo:IAO_0000039 ;
        sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "An amount must have exactly one QUDT unit IRI." ;
    ] .

# ── Flow property ─────────────────────────────────────────────────────────────

shape:flow_property
    a sh:NodeShape ;
    sh:class uplci:FlowPropertyDatum ;
    sh:property [
        sh:path uplci:hasFlowPropertyType ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( uplci:MonetaryValuePerUnit uplci:ClimateChangePerUnit uplci:OtherFlowProperty ) ;
        sh:message "A flow property must have exactly one property type." ;
    ] ;
    sh:property [
        sh:path ( obo:OBI_0001938 obo:OBI_0001937 ) ;
        sh:datatype xsd:double ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A flow property must have exactly one numeric value." ;
    ] ;
    sh:property [
        sh:path uplci:currency ;
        sh:maxCount 1 ; sh:pattern "^[A-Z]{3}$" ;
        sh:message "Currency must be an ISO 4217 code such as EUR." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A monetary flow property must state its currency." ;
        sh:prefixes shape:prefixes ;
        sh:select """
            SELECT $this WHERE {
                $this uplci:hasFlowPropertyType uplci:MonetaryValuePerUnit .
                FILTER NOT EXISTS { $this uplci:currency ?c }
            }""" ;
    ] .

# ── Background provider ───────────────────────────────────────────────────────

shape:background_provider
    a sh:NodeShape ;
    sh:class uplci:BackgroundDatasetReference ;
    sh:property [
        sh:path uplci:inDatabase ; sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A background provider must name exactly one database." ;
    ] ;
    sh:property [
        sh:path rdfs:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A background provider must name the activity." ;
    ] ;
    sh:property [
        sh:path dcterms:identifier ; sh:datatype xsd:string ; sh:maxCount 1 ;
    ] .

# ── Technology parameter (pmdco:ParameterSpecification) ───────────────────────

shape:technology_parameter
    a sh:NodeShape ;
    sh:class pmd:PMD_0000013 ;
    sh:property [
        sh:path rdfs:label ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:message "A technology parameter must have exactly one name." ;
    ] ;
    sh:property [
        sh:path uplci:hasParameterCategory ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ( uplci:FacilityParameter uplci:ProcessParameter uplci:OperationParameter ) ;
        sh:message "A technology parameter must be a facility, process or operation parameter." ;
    ] ;
    sh:property [
        sh:path qudt:value ; sh:datatype xsd:double ; sh:maxCount 1 ;
        sh:message "Parameter value must be a single xsd:double." ;
    ] ;
    sh:property [
        sh:path qudt:hasUnit ; sh:nodeKind sh:IRI ; sh:maxCount 1 ;
        sh:message "Parameter unit must be a single QUDT unit IRI." ;
    ] ;
    sh:property [
        sh:path uplci:isScalable ; sh:datatype xsd:boolean ; sh:maxCount 1 ;
    ] .
