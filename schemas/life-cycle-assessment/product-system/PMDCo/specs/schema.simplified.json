{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.simplified.json",
  "title": "LCA Product System (Simplified Input)",
  "description": "Flat input for an LCA product system; converted to PMDCo/UPLCI OO-LD by transform.simplified.jsonata.",
  "type": "object",
  "required": [
    "system_name",
    "inventories",
    "reference_inventory",
    "functional_unit"
  ],
  "additionalProperties": false,
  "properties": {
    "system_name": {
      "type": "string",
      "minLength": 1
    },
    "system_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "inventories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "IRIs of member unit process inventories."
    },
    "reference_inventory": {
      "type": "string",
      "format": "uri",
      "description": "Inventory delivering the functional unit; must be one of `inventories`."
    },
    "functional_unit": {
      "type": "string"
    },
    "reference_amount": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "default": 1
        },
        "unit": {
          "type": "string",
          "examples": [
            "kg",
            "piece",
            "uqudt:KiloGM"
          ]
        }
      }
    },
    "background_database": {
      "type": "string",
      "examples": [
        "ecoinvent-3.8-consequential",
        "ecoinvent-3.10-cutoff"
      ]
    }
  }
}
