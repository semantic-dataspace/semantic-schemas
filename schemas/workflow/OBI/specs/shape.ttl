# SHACL shape for the Workflow (OBI:AnalyticProtocol) pattern.
#
# Validates:
#   1. Workflow node (OBI_0000272 / AnalyticProtocol)
#      - must have rdfs:label
#      - must have dcterms:conformsTo
#      - must reference at least one process step via bfo:BFO_0000051 (has_part)
#
# Steps are recorded as independent process-step instances (x-process-step
# schemas) and referenced here by IRI.  No inline step validation is
# performed; each step is validated by its own schema's SHACL shape.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obi:     <http://purl.obolibrary.org/obo/OBI_> .
@prefix bfo:     <http://purl.obolibrary.org/obo/BFO_> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix shape:   <https://w3id.org/pmd/co/shapes/workflow/> .
@base            <https://w3id.org/pmd/co/shapes/workflow/> .

shape:workflow
    a sh:NodeShape ;
    sh:targetClass obi:0000272 ;
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Workflow must declare dcterms:conformsTo pointing to the versioned schema IRI." ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Workflow must have exactly one rdfs:label." ;
    ] ;
    sh:property [
        sh:path bfo:0000051 ;
        sh:minCount 1 ;
        sh:message "A Workflow must reference at least one process step via bfo:BFO_0000051 (has_part)." ;
    ] ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) .
