(
  /*
   * Calibration Generic (PMDCo/CHAMEO): simplified JSON → OO-LD JSON
   *
   * Input fields (see schema.simplified.json):
   *   calibration_name    string   required
   *   calibration_id      string   optional, derived from calibration_name if omitted
   *   calibration_type    string   required: Temperature | Sensitivity | TauR | Load Cell | Displacement | Other
   *   valid_from          string   required: ISO 8601 date
   *   valid_until         string   optional: ISO 8601 date
   *   measurement_device  string   optional: IRI of measurement-device KItem
   *   reference_standards array    optional: IRI strings (has_specified_input)
   *   conditions          array    optional: PMDCo ParameterSpecification nodes
   *     name              string   required
   *     value             number   optional
   *     unit              string   optional: vocabulary label or QUDT IRI
   *   results             array    optional: accuracy claim MeasurementDatum nodes
   *     name              string   required
   *     value             number   required
   *     unit              string   required: vocabulary label or QUDT IRI
   */

  $schemaUri := "https://raw.githubusercontent.com/semantic-dataspace/semantic-schemas/kiran/schemas/calibration/generic/PMDCo/specs/schema.oold.generated.json";

  $slug  := $replace($lowercase($trim(calibration_name)), /[^a-z0-9]+/, "-");
  $calId := $exists(calibration_id) ? calibration_id : "cal-generic-" & $slug;

  $conditions := $exists(conditions) and $count(conditions) > 0
    ? $map(conditions, function($c, $i) {(
        $node := {
          "type":            "pmdco:PMD_0000013",
          "id":              $calId & "-condition-" & $string($i + 1),
          "parameter_label": $c.name,
          "parameter_type":  $exists($c.type_iri) ? $c.type_iri : $c.name
        };
        $withValue := $exists($c.value) ? $merge([$node, {"parameter_value": $c.value}]) : $node;
        $exists($c.unit) ? $merge([$withValue, {"parameter_unit": $c.unit}]) : $withValue
      )})
    : undefined;

  $measured := $exists(results) and $count(results) > 0
    ? $map(results, function($r, $i) {(
        $rSlug     := $replace($lowercase($trim($r.name)), /[^a-z0-9]+/, "-");
        $datumBase := $calId & "-result-" & $rSlug;
        $svs := {
          "type":         "obo:OBI_0001931",
          "id":           $datumBase & "-svs",
          "result_value": $r.value
        };
        $withUnit := $exists($r.unit) ? $merge([$svs, {"result_unit": $r.unit}]) : $svs;
        {
          "type":           "obo:IAO_0000109",
          "id":             $datumBase & "-smd",
          "label":          $r.name,
          "has_value_spec": $withUnit
        }
      )})
    : undefined;

  $base := {
    "conforms_to":      $schemaUri,
    "type":             "chameo:Calibration",
    "id":               $calId,
    "label":            calibration_name,
    "calibration_type": calibration_type,
    "valid_from":       valid_from
  };

  $withUntil  := $exists(valid_until)          ? $merge([$base,       {"valid_until":        valid_until}])          : $base;
  $withDevice := $exists(measurement_device)   ? $merge([$withUntil,  {"uses_instrument":    measurement_device}])   : $withUntil;
  $withStds   := $exists(reference_standards) and $count(reference_standards) > 0
                   ? $merge([$withDevice, {"has_specified_input": reference_standards}])
                   : $withDevice;
  $withConds  := $exists($conditions)          ? $merge([$withStds,   {"has_process_attribute": $conditions}])       : $withStds;

  $exists($measured)
    ? $merge([$withConds, {"measured_properties": $measured}])
    : $withConds
)
