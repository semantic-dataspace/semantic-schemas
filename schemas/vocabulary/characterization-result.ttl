# =============================================================================
# 6. DSC (Differential Scanning Calorimetry) — dsmdsc: namespace
#    IRIs defined in dsc-heat-flow-measurement.ttl. Copied here so the
#    characterization-result vocabulary service exposes them in dropdowns.
# =============================================================================

dsmdsc:OnsetTemperature           a owl:Class ; rdfs:label "Onset Temperature"@en .
dsmdsc:PeakTemperature            a owl:Class ; rdfs:label "Peak Temperature"@en .
dsmdsc:EndTemperature             a owl:Class ; rdfs:label "End Temperature"@en .
dsmdsc:GlassTransitionTemperature a owl:Class ; rdfs:label "Glass Transition Temperature (Tg)"@en .
dsmdsc:SolidusTemperature         a owl:Class ; rdfs:label "Solidus Temperature"@en .
dsmdsc:LiquidusTemperature        a owl:Class ; rdfs:label "Liquidus Temperature"@en .
dsmdsc:Enthalpy                   a owl:Class ; rdfs:label "Enthalpy of Transformation"@en .
dsmdsc:SpecificHeatCapacity       a owl:Class ; rdfs:label "Specific Heat Capacity"@en .

# =============================================================================
# 7. FATIGUE — EMMO classes (IRIs TBD; placeholder)
# =============================================================================

# emmo:EMMO_XXXXXXXX  a owl:Class ; rdfs:label "Fatigue Life (Nf)"@en .
# emmo:EMMO_XXXXXXXX  a owl:Class ; rdfs:label "Stress Amplitude"@en .
