@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

# Tensile Test Ontology (TTO) v3.0.0
# https://w3id.org/pmd/tto/
@prefix tto:    <https://w3id.org/pmd/tto/> .

# Platform MaterialDigital Core Ontology (PMDCo)
# https://w3id.org/pmd/co/
@prefix pmdco:  <https://w3id.org/pmd/co/> .

# European Materials Modelling Ontology (EMMO) — mechanical domain
# https://emmo.info/
@prefix emmo:   <https://w3id.org/emmo#> .

# =============================================================================
# Characterization result types from EXISTING standard ontologies
#
# Vocabulary service namespace : characterization-result
# Use-cases served             : tensile-test, hardness, all
# Complementary file           : characterization-result-nanoindentation.ttl
#
# Labels match the strings that DSMS schemas and parsers pass as result name.
# IRIs are the canonical class IRIs from the respective ontology — NOT copied
# into a dsms: namespace.
# =============================================================================

# ── Tensile Test — TTO classes (TTO v3.0.0) ──────────────────────────────────
# IRIs confirmed from schemas/characterization/tensile-test/TTO/specs/schema.oold.yaml
# TTO IRI base: https://w3id.org/pmd/tto/

tto:TTO_0000009  a owl:Class ; rdfs:label "Yield Strength (Re)"@en ;
    skos:definition "Lower yield strength or general yield stress measured under uniaxial tension per ISO 6892-1."@en .

tto:TTO_0000059  a owl:Class ; rdfs:label "Upper Yield Strength (ReH)"@en ;
    skos:definition "Maximum stress reached before the first decrease in force during plastic yielding (ISO 6892-1)."@en .

tto:TTO_0000022  a owl:Class ; rdfs:label "Lower Yield Strength (ReL)"@en ;
    skos:definition "Lowest stress during plastic yielding, ignoring any transient initial effects (ISO 6892-1)."@en .

tto:TTO_0000053  a owl:Class ; rdfs:label "Tensile Strength (Rm)"@en ;
    skos:definition "Maximum force divided by the original cross-sectional area (ISO 6892-1)."@en .

tto:TTO_0000047  a owl:Class ; rdfs:label "Proof Strength (Rp0.2)"@en ;
    skos:definition "Stress at which the plastic strain equals 0.2 % of the gauge length (ISO 6892-1)."@en .

tto:TTO_0000033  a owl:Class ; rdfs:label "Elongation After Fracture (A)"@en ;
    skos:definition "Permanent elongation of the gauge length after fracture, expressed as percentage (ISO 6892-1)."@en .

tto:TTO_0000035  a owl:Class ; rdfs:label "Uniform Elongation (Ag)"@en ;
    skos:definition "Elongation at maximum force, corresponding to the onset of necking (ISO 6892-1)."@en .

tto:TTO_0000038  a owl:Class ; rdfs:label "Reduction of Area (Z)"@en ;
    skos:definition "Ratio of the change in cross-sectional area at fracture to the original area (ISO 6892-1)."@en .

# Young's Modulus — IRI requires TTO version confirmation;
# TTO_0000YYY placeholder kept here; replace when confirmed.
# tto:TTO_0000YYY  a owl:Class ; rdfs:label "Young's Modulus (E)"@en .

