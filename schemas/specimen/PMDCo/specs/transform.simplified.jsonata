(
  /*
   * Specimen (PMDCo): simplified JSON → OO-LD JSON
   *
   * Input fields (see schema.simplified.json):
   *   specimen_name  string   required
   *   mass_value     number   optional
   *   mass_unit      string   optional: "g" | "kg" | "mg"  (default "g")
   *   material       string   optional: IRI of an existing material kitem
   *
   * Run with the jsonata-python CLI:
   *   python -m jsonata -e transform.jsonata -i ../docs/example.input.json
   */

  $schemaUri := "https://raw.githubusercontent.com/semantic-dataspace/semantic-schemas/specimen-PMDCo-v0.2.0/schemas/specimen/PMDCo/specs/schema.oold.yaml";

  /* ── Mass unit label → Unit Ontology IRI ────────────────────────────── */
  $massUnitMap := {
    "g":  "uo:0000021",
    "kg": "uo:0000022",
    "mg": "uo:0000023"
  };

  /* ── Node ID ─────────────────────────────────────────────────────────── */
  $slug   := $replace($lowercase($trim(specimen_name)), /[^a-z0-9]+/, "-");
  $specId := "specimen-" & $slug;

  /* ── Mass quality (optional) ─────────────────────────────────────────── */
  $massBlock := $exists(mass_value) ? {
    "type":       "pmdco:PMD_0020133",
    "id":         "mass-" & $specId,
    "quality_of": $specId,
    "specified_by_value": {
      "type":  "obi:0001931",
      "id":    "mass-svs-" & $specId,
      "value": mass_value,
      "unit":  $lookup($massUnitMap, $exists(mass_unit) ? mass_unit : "g")
    }
  } : undefined;

  /* ── OO-LD output ────────────────────────────────────────────────────── */
  {
    "conforms_to": $schemaUri,
    "type":     "bfo:0000030",
    "id":       $specId,
    "label":    specimen_name,
    "mass":     $massBlock,
    "material": material
  }
)
