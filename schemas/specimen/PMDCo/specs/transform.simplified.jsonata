(
  /*
   * Specimen (PMDCo): simplified JSON → OO-LD JSON
   *
   * Input fields:
   *   specimen_name        string   required
   *   material             string   optional: IRI of material kitem
   *   source               string|array  optional: IRI(s) of parent billet/specimen kitem(s)
   *   temporal_start       string   optional: ISO date (YYYY-MM-DD) — start of this temporal state
   *   temporal_end         string   optional: ISO date (YYYY-MM-DD) — end of this temporal state
   *   specimen_form        string   optional: "Bulk"|"Thin Film"|...
   *   surface_preparation  string   optional: free text
   *   physical_properties  array    optional: [{type, value, unit}]
   *   mass_value           number   optional: deprecated, kept for backwards compat
   *   mass_unit            string   optional: deprecated
   */

  $schemaUri := "https://raw.githubusercontent.com/semantic-dataspace/semantic-schemas/kiran/schemas/specimen/PMDCo/specs/schema.oold.yaml";

  /* ── Node ID ─────────────────────────────────────────────────────────── */
  $slug   := $replace($lowercase($trim(specimen_name)), /[^a-z0-9]+/, "-");
  $specId := "specimen-" & $slug;

  /* ── Property type → PMDCo quality class IRI ─────────────────────────── */
  $typeMap := {
    "Diameter":              "pmdco:PMD_0050051",
    "Thickness":             "pmdco:PMD_0050153",
    "Width":                 "pmdco:PMD_0050154",
    "Length":                "pmdco:PMD_0040001",
    "Mass":                  "pmdco:PMD_0020133",
    "Surface Roughness Ra":  "dspec:SurfaceRoughnessRa",
    "Surface Roughness Rq":  "dspec:SurfaceRoughnessRq"
  };

  /* ── Unit label → Unit Ontology IRI ─────────────────────────────────── */
  $unitMap := {
    "mm": "obo:UO_0000015",
    "um": "obo:UO_0000017",
    "nm": "obo:UO_0000018",
    "g":  "obo:UO_0000021",
    "kg": "obo:UO_0000022",
    "mg": "obo:UO_0000023"
  };

  /* ── Build physical property quality nodes ───────────────────────────── */
  $physProps := $append([], $map(physical_properties, function($p, $i) {
    {
      "type":       $lookup($typeMap, $p.type),
      "id":         "phys-prop-" & $string($i + 1) & "-" & $specId,
      "inheres_in": $specId,
      "specified_by_value": {
        "type":  ["obi:0001931"],
        "id":    "phys-prop-svs-" & $string($i + 1) & "-" & $specId,
        "value": $p.value,
        "unit":  $lookup($unitMap, $p.unit)
      }
    }
  }));

  /* ── Legacy mass block (deprecated mass_value / mass_unit) ───────────── */
  $legacyMass := $exists(mass_value) and $not($exists(
    physical_properties[type = "Mass"]
  )) ? {
    "type":       "pmdco:PMD_0020133",
    "id":         "mass-" & $specId,
    "inheres_in": $specId,
    "specified_by_value": {
      "type":  ["obi:0001931"],
      "id":    "mass-svs-" & $specId,
      "value": mass_value,
      "unit":  $lookup($unitMap, $exists(mass_unit) ? mass_unit : "g")
    }
  } : undefined;

  /* ── Merge physical_properties + legacy mass into one array ─────────── */
  $allPhys := $append(
    $exists($physProps) ? $physProps : [],
    $exists($legacyMass) ? [$legacyMass] : []
  );

  /* ── Temporal interval (BFO_0000202 + instants) ─────────────────────── */
  /* Build exists_at only when at least a start date is provided.          */
  $startInstant := $exists(temporal_start) ? {
    "type": ["bfo:0000148"],
    "id":   $specId & "-temporal-start",
    "instant_date": temporal_start
  } : undefined;

  $endInstant := $exists(temporal_end) ? {
    "type": ["bfo:0000148"],
    "id":   $specId & "-temporal-end",
    "instant_date": temporal_end
  } : undefined;

  $temporalInterval := $exists($startInstant) ? $merge([
    {
      "type": ["bfo:0000202"],
      "id":   $specId & "-temporal-interval",
      "has_first_instant": $startInstant
    },
    $exists($endInstant) ? {"has_last_instant": $endInstant} : {}
  ]) : undefined;

  /* ── Source: normalise scalar string → array ─────────────────────────── */
  $sourceArr := $type(source) = "string" ? [source]
              : ($exists(source) and $count(source) > 0) ? source
              : undefined;

  /* ── OO-LD output ────────────────────────────────────────────────────── */
  $base := {
    "conforms_to":         $schemaUri,
    "type":                ["bfo:0000030", "pmdco:PMD_0000068"],
    "id":                  $specId,
    "label":               specimen_name,
    "material":            material,
    "specimen_form":       specimen_form,
    "surface_preparation": surface_preparation
  };

  $withSource := $exists($sourceArr)
    ? $merge([$base, {"source": $sourceArr}])
    : $base;

  $withTemporal := $exists($temporalInterval)
    ? $merge([$withSource, {"exists_at": $temporalInterval}])
    : $withSource;

  $exists($allPhys) and $count($allPhys) > 0
    ? $merge([$withTemporal, {"physical_properties": $allPhys}])
    : $withTemporal
)
