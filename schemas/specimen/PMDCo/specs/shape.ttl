# SHACL shape for the PMDCo Specimen (TemporallyQualifiedContinuant) pattern.
#
# v0.7.0: specimen is typed as BFO_0000030 + PMD_0000068 (TQC).
# Material link uses PMD_0000070 (is_state_of), not schema:material.
# Physical properties are quality nodes (RO_0000086 has_quality), each with
# inheres_in (RO_0000052) back-ref and a ScalarValueSpecification (OBI_0001931)
# carrying the value (OBI_0001937) and QUDT unit (qudt:hasUnit).
# Source is now an array (prov:wasDerivedFrom, no maxCount).

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo:     <http://purl.obolibrary.org/obo/> .
@prefix pmd:     <https://w3id.org/pmd/co/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix shape:   <https://w3id.org/pmd/co/shapes/specimen/> .
@prefix :        <https://w3id.org/pmd/co/shapes/specimen/> .
@base            <https://w3id.org/pmd/co/shapes/specimen/> .

# ── Specimen node (TQC: BFO_0000030 + PMD_0000068) ────────────────────────

shape:specimen
    a sh:NodeShape ;
    sh:targetClass <http://purl.obolibrary.org/obo/BFO_0000030> ;   # bfo:Object
    sh:property [
        sh:path dcterms:conformsTo ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Specimen must declare dcterms:conformsTo pointing to the versioned schema IRI." ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Specimen must have exactly one rdfs:label." ;
    ] ;
    sh:property [
        sh:path pmd:PMD_0000070 ;   # is_state_of
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "material (is_state_of, PMD_0000070) must be a single IRI reference to a material k-item." ;
    ] ;
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:nodeKind sh:IRI ;
        sh:message "Each prov:wasDerivedFrom must be an IRI reference to a source k-item." ;
    ] ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) .

# ── Physical property quality node (any PMDCo quality class) ──────────────
# Targets PMD_0020133 (Mass) explicitly; other quality classes are open.

shape:physical_property
    a sh:NodeShape ;
    sh:targetClass pmd:PMD_0020133 ;    # Mass (most constrained quality class)
    sh:property [
        sh:path obo:RO_0000052 ;        # inheres_in
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A physical property quality must inheres_in exactly one specimen (IRI)." ;
    ] ;
    sh:property [
        sh:path pmd:PMD_0000077 ;       # specified_by_value
        sh:node shape:scalar_value_specification ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) .

# ── ScalarValueSpecification (OBI_0001931) ─────────────────────────────────

shape:scalar_value_specification
    a sh:NodeShape ;
    sh:property [
        sh:path obo:OBI_0001937 ;       # has_specified_numeric_value
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minExclusive 0.0 ;
        sh:message "Physical property value must be a positive number." ;
    ] ;
    sh:property [
        sh:path qudt:hasUnit ;          # QUDT unit IRI
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:message "Physical property unit must be a QUDT unit IRI." ;
    ] ;
    sh:closed false ;
    sh:ignoredProperties ( rdf:type ) .
