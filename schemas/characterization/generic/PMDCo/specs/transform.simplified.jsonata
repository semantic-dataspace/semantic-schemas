(
  /*
   * Characterization Generic (PMDCo): simplified JSON → OO-LD JSON
   *
   * Input fields (see schema.simplified.json):
   *   step_name    string   required
   *   step_id      string   optional, derived from step_name if omitted
   *   description  string   optional
   *   measurement_device  string   optional: IRI of measurement-device KItem (chameo:usesInstrument)
   *   inputs       array    optional: specimen/material IRI strings (has_specified_input)
   *   outputs      array    optional: dataset/specimen IRI strings (has_specified_output)
   *   preceded_by  array    optional: step IRI strings
   *   conditions   array    optional: PMDCo ParameterSpecification nodes
   *     name       string   required: vocabulary label, e.g. "Test Temperature"
   *     value      number   optional
   *     unit       string   optional: vocabulary label or QUDT IRI
   *   results      array    optional: MeasurementDatum (IAO_0000109) nodes
   *     name       string   required: property label (stored as rdfs:label)
   *     value      number   optional
   *     unit       string   optional: vocabulary label or QUDT IRI
   */

  $schemaUri := "https://raw.githubusercontent.com/semantic-dataspace/semantic-schemas/kiran/schemas/characterization/generic/PMDCo/specs/schema.oold.generated.json";

  $slug   := $replace($lowercase($trim(step_name)), /[^a-z0-9]+/, "-");
  $stepId := $exists(step_id) ? step_id : "char-generic-" & $slug;

  $conditions := $exists(conditions) and $count(conditions) > 0
    ? $map(conditions, function($c, $i) {(
        $node := {
          "type":            "pmdco:PMD_0000013",
          "id":              $stepId & "-condition-" & $string($i + 1),
          "parameter_label": $c.name,
          "parameter_type":  $exists($c.type_iri) ? $c.type_iri : $c.name
        };
        $withValue := $exists($c.value) ? $merge([$node, {"parameter_value": $c.value}]) : $node;
        $exists($c.unit) ? $merge([$withValue, {"parameter_unit": $c.unit}]) : $withValue
      )})
    : undefined;

  $firstInput := $exists(inputs) and $count(inputs) > 0 ? inputs[0] : undefined;

  $measured := $exists(results) and $count(results) > 0
    ? $map(results, function($r, $i) {(
        $rSlug     := $replace($lowercase($trim($r.name)), /[^a-z0-9]+/, "-");
        $datumBase := $stepId & "-result-" & $rSlug;
        $qualityNode := $merge([
          {"quality_type": $r.name, "id": $datumBase & "-quality"},
          $exists($firstInput) ? {"quality_of": $firstInput} : {}
        ]);
        $svs := {
          "type":         "obo:OBI_0001931",
          "id":           $datumBase & "-svs",
          "result_value": $r.value
        };
        $withUnit := $exists($r.unit) ? $merge([$svs, {"result_unit": $r.unit}]) : $svs;
        {
          "type":           "obo:IAO_0000109",
          "id":             $datumBase & "-smd",
          "label":          $r.name,
          "is_about":       $qualityNode,
          "has_value_spec": $withUnit
        }
      )})
    : undefined;

  $base := {
    "conforms_to": $schemaUri,
    "type":  "obi:0000070",
    "id":    $stepId,
    "label": step_name
  };

  $withDesc     := $exists(description)       ? $merge([$base,         {"description":           description}])       : $base;
  $withDevice   := $exists(measurement_device) ? $merge([$withDesc,    {"measurement_device":     measurement_device}]) : $withDesc;
  $withInputs   := $exists(inputs)   and $count(inputs)   > 0 ? $merge([$withDevice,  {"has_specified_input":  inputs}])   : $withDevice;
  $withOutputs  := $exists(outputs)  and $count(outputs)  > 0 ? $merge([$withInputs,  {"has_specified_output": outputs}])  : $withInputs;
  $withPreceded := $exists(preceded_by) and $count(preceded_by) > 0 ? $merge([$withOutputs, {"preceded_by": preceded_by}]) : $withOutputs;
  $withConds    := $exists($conditions) ? $merge([$withPreceded, {"has_process_attribute": $conditions}]) : $withPreceded;

  $exists($measured)
    ? $merge([$withConds, {"measured_properties": $measured}])
    : $withConds
)
