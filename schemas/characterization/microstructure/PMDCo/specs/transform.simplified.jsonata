(
  /*
   * Microstructure Characterization (PMDCo measurement pattern): simplified JSON → OO-LD JSON
   *
   * Input fields (see schema.simplified.json):
   *   experiment_name       string   required
   *   specimen_iri          string   required: IRI of the specimen KItem
   *   experiment_id         string   optional, derived from experiment_name if omitted
   *   test_date             string   optional, ISO 8601 date-time
   *   technique             string   optional: enum (SEM, TEM, EBSD, …)
   *   magnification         number   optional
   *   accelerating_voltage_kv number optional (kV)
   *   area_analysed_um2     number   optional (µm²)
   *   etching_method        string   optional
   *   software              string   optional
   *   results               array    optional
   *     name                string   free-text property name
   *     value               number
   *     unit                string   "um" | "nm" | "vol%" | "1/um2" | "-" | "deg"
   */

  $schemaUri := "https://raw.githubusercontent.com/semantic-dataspace/semantic-schemas/microstructure-PMDCo-v0.1.0/schemas/characterization/microstructure/PMDCo/specs/schema.oold.yaml";

  /* ── Unit label → QUDT unit IRI ──────────────────────────────────────── */
  $unitMap := {
    "um":     "uqudt:MicroM",
    "nm":     "uqudt:NanoM",
    "vol%":   "uqudt:PERCENT",
    "1/um2":  "uqudt:PER-M2",
    "-":      "uqudt:UNITLESS",
    "deg":    "uqudt:DEG"
  };

  /* ── Quality class: result label → dsmsms: controlled vocabulary IRI ─── */
  /* Classes minted in dsmsms: namespace until an EMMO microstructure module */
  /* provides canonical IRIs for grain/phase/precipitate descriptors.        */
  $qualityMap := {
    "Mean Grain Diameter":        "dsmsms:MeanGrainDiameter",
    "D10 Grain Diameter":         "dsmsms:D10GrainDiameter",
    "D50 Grain Diameter":         "dsmsms:D50GrainDiameter",
    "D90 Grain Diameter":         "dsmsms:D90GrainDiameter",
    "Grain Aspect Ratio":         "dsmsms:GrainAspectRatio",
    "Phase Fraction Al-matrix":   "dsmsms:PhaseFractionAlMatrix",
    "Phase Fraction S-phase":     "dsmsms:PhaseFractionSPhase",
    "Phase Fraction Al2Cu":       "dsmsms:PhaseFractionAl2Cu",
    "Phase Fraction Al9FeNi":     "dsmsms:PhaseFractionAl9FeNi",
    "Mean Precipitate Diameter":  "dsmsms:MeanPrecipitateDiameter",
    "Precipitate Number Density": "dsmsms:PrecipitateNumberDensity",
    "Porosity":                   "dsmsms:Porosity"
  };

  /* ── Capture document fields as $ vars for closures ─────────────────── */
  $specimenIri := specimen_iri;
  $slug        := $replace($lowercase($trim(experiment_name)), /[^a-z0-9]+/, "-");
  $expId       := $exists(experiment_id) ? experiment_id : "microstructure-" & $slug;

  /* ── Process conditions (ParameterSpecification nodes) ───────────────── */
  $conds := [];
  $conds := $exists(technique)
    ? $append($conds, [{"type": "pmdco:PMD_0000013", "id": $expId & "-cond-technique",
        "parameter_label": "Technique", "label": technique}])
    : $conds;
  $conds := $exists(magnification)
    ? $append($conds, [{"type": "pmdco:PMD_0000013", "id": $expId & "-cond-magnification",
        "parameter_label": "Magnification", "parameter_value": magnification, "parameter_unit": "uqudt:UNITLESS"}])
    : $conds;
  $conds := $exists(accelerating_voltage_kv)
    ? $append($conds, [{"type": "pmdco:PMD_0000013", "id": $expId & "-cond-voltage",
        "parameter_label": "Accelerating Voltage", "parameter_value": accelerating_voltage_kv, "parameter_unit": "uqudt:KiloV"}])
    : $conds;
  $conds := $exists(area_analysed_um2)
    ? $append($conds, [{"type": "pmdco:PMD_0000013", "id": $expId & "-cond-area",
        "parameter_label": "Area Analysed", "parameter_value": area_analysed_um2, "parameter_unit": "uqudt:MicroM2"}])
    : $conds;

  /* ── Measured results: MeasurementDatum + quality individual + ScalarValueSpec ─ */
  /* Full OBI pattern: datum IAO_0000136 quality_individual; quality_individual
     rdf:type <dsmsms:QualityClass>; quality_individual RO_0000080 specimen. */
  $measured := $exists(results) and $count(results) > 0
    ? $map(results, function($r, $i) {(
        $rSlug     := $replace($lowercase($trim($r.name)), /[^a-z0-9]+/, "-");
        $datumBase := $expId & "-result-" & $rSlug;
        $qType     := $lookup($qualityMap, $r.name);
        {
          "type":  "obo:IAO_0000109",
          "id":    $datumBase & "-smd",
          "label": $r.name,
          "is_about": $exists($qType)
            ? { "quality_type": $qType, "id": $datumBase & "-quality", "quality_of": $specimenIri }
            : { "id": $datumBase & "-quality", "quality_of": $specimenIri },
          "has_value_spec": {
            "type":         "obo:OBI_0001931",
            "id":           $datumBase & "-svs",
            "result_value": $r.value,
            "result_unit":  $lookup($unitMap, $r.unit)
          }
        }
      )})
    : undefined;

  /* ── OO-LD output ─────────────────────────────────────────────────────── */
  $base := {
    "conforms_to":         $schemaUri,
    "type":                "obi:OBI_0000070",
    "id":                  $expId,
    "label":               experiment_name,
    "has_specified_input": [$specimenIri]
  };

  $withDate    := $exists(test_date)      ? $merge([$base,      {"date": test_date}])                    : $base;
  $withConds   := $count($conds) > 0     ? $merge([$withDate,  {"has_process_attribute": $conds}])       : $withDate;
  $withEtch    := $exists(etching_method) ? $merge([$withConds, {"etching_method": etching_method}])     : $withConds;
  $withSw      := $exists(software)       ? $merge([$withEtch,  {"software": software}])                 : $withEtch;

  $exists($measured)
    ? $merge([$withSw, {"measured_properties": $measured}])
    : $withSw
)
