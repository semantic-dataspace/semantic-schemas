@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dsms:    <https://w3id.org/dsms/nanoindentation#> .
@prefix pmdco:   <https://w3id.org/pmd/co/> .
@prefix nanoind: <https://w3id.org/emmo/domain/nanoindentation#> .

# ────────────────────────────────────────────────────────────────────────────
# DSMS Nanoindentation Controlled Vocabulary
# IRI: https://w3id.org/dsms/nanoindentation
#
# Terms defined here are needed for nanoindentation schemas but are not yet
# present in the EMMO nanoindentation domain ontology or PMDCo.
# These should be proposed for inclusion in EMMO nanoindentation as the
# ontology matures.
# ────────────────────────────────────────────────────────────────────────────

<https://w3id.org/dsms/nanoindentation>
    a owl:Ontology ;
    rdfs:label "DSMS Nanoindentation Controlled Vocabulary"@en ;
    dcterms:description "Controlled vocabulary for nanoindentation concepts not yet covered by EMMO (https://w3id.org/emmo/domain/nanoindentation) or PMDCo. Maintained by Fraunhofer IWM / DSMS project."@en ;
    dcterms:created "2026-09-24"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://w3id.org/emmo/domain/nanoindentation> .

# ── Instrument metadata properties ─────────────────────────────────────────

dsms:instrumentSerialNumber
    a owl:DatatypeProperty ;
    rdfs:label "instrument serial number"@en ;
    rdfs:range xsd:string .

dsms:controlMode
    a owl:DatatypeProperty ;
    rdfs:label "control mode"@en ;
    rdfs:comment "Indentation control mode: depth-controlled, load-controlled, constant strain rate, or oscillating (CSM)."@en ;
    rdfs:range xsd:string .

dsms:indenterGeometry
    a owl:DatatypeProperty ;
    rdfs:label "indenter geometry"@en ;
    rdfs:range xsd:string .

dsms:indenterMaterial
    a owl:DatatypeProperty ;
    rdfs:label "indenter material"@en ;
    rdfs:range xsd:string .

# ── Analysis settings properties ────────────────────────────────────────────

dsms:analysisMethod
    a owl:DatatypeProperty ;
    rdfs:label "analysis method"@en ;
    rdfs:comment "Contact mechanics model used to derive hardness and elastic modulus from the load-displacement curve (e.g. Oliver & Pharr, ISO 14577)."@en ;
    rdfs:range xsd:string .

dsms:unloadFitRange
    a owl:DatatypeProperty ;
    rdfs:label "unload fit range"@en ;
    rdfs:comment "Percentage range of the unloading curve used for the power-law fit, e.g. '40%-98%'."@en ;
    rdfs:range xsd:string .

dsms:testStandard
    a owl:DatatypeProperty ;
    rdfs:label "test standard"@en ;
    rdfs:comment "Normative standard the measurement was performed under, e.g. 'ISO 14577-1:2015'."@en ;
    rdfs:range xsd:string .

dsms:tipAreaFunction
    a owl:DatatypeProperty ;
    rdfs:label "tip area function reference"@en ;
    rdfs:comment "Identifier or description of the tip area function / calibration used."@en ;
    rdfs:range xsd:string .

dsms:testTemperature
    a owl:DatatypeProperty ;
    rdfs:label "test temperature"@en ;
    rdfs:comment "Ambient temperature in °C at the time of measurement (ISO 14577: 23 ± 5 °C)."@en ;
    rdfs:range xsd:double .

dsms:testRelativeHumidity
    a owl:DatatypeProperty ;
    rdfs:label "test relative humidity"@en ;
    rdfs:comment "Ambient relative humidity in % at the time of measurement (ISO 14577: 45 ± 10 %)."@en ;
    rdfs:range xsd:double .

# ── Analysis model input ────────────────────────────────────────────────────

dsms:AssumedPoissonsRatio
    a owl:Class ;
    rdfs:label "Assumed Poisson's Ratio"@en ;
    rdfs:comment "The Poisson's ratio of the test material assumed by the analyst as an input to the contact mechanics model (e.g. Oliver-Pharr, ISO 14577). Not directly measured; required to calculate indentation elastic modulus EIT from reduced modulus E*."@en ;
    skos:scopeNote "Dimensionless scalar (uqudt:UNITLESS). Typical values: steel ≈ 0.30, aluminium ≈ 0.33, fused silica ≈ 0.17. Stored as a pmdco:PMD_0000013 (ParameterSpecification) node so it is captured alongside controllable protocol parameters."@en ;
    rdfs:subClassOf pmdco:PMD_0000013 .

# ============================================================================
# Per-indent measurement result quality classes
#
# These classes are used as rdf:type for quality individuals generated by
# the dataset/nanoindentation/PMDCo transform. Each quality individual:
#   <datum>    obo:IAO_0000136 <quality_individual>
#   <quality_individual> a dsms:<ClassName> ; obo:RO_0000080 <specimen>
#
# All classes are subclasses of obo:BFO_0000019 (Quality).
# Align to EMMO nanoindentation module (https://w3id.org/emmo/domain/nanoindentation)
# when stable class IRIs are confirmed.
# ============================================================================

@prefix obo: <http://purl.obolibrary.org/obo/> .

# ── Mechanical response ─────────────────────────────────────────────────────

dsms:HardnessHIT
    a owl:Class ;
    rdfs:label "Indentation Hardness HIT"@en ;
    rdfs:comment "Indentation hardness as defined in ISO 14577: ratio of maximum test force Fmax to the projected contact area Ap at maximum force. Units: GPa."@en ;
    skos:altLabel "HIT"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:ElasticModulusEIT
    a owl:Class ;
    rdfs:label "Indentation Elastic Modulus EIT"@en ;
    rdfs:comment "Elastic modulus of the test material derived from the unloading curve slope using the Oliver-Pharr method, accounting for the assumed Poisson's ratio. Units: GPa."@en ;
    skos:altLabel "EIT"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:ReducedModulusE
    a owl:Class ;
    rdfs:label "Reduced Modulus E*"@en ;
    rdfs:comment "Combined elastic modulus of the indenter-sample contact (accounts for elasticity of both tip and specimen). Derived from contact stiffness S and projected area Ap. Units: GPa."@en ;
    skos:altLabel "E*"@en, "Er_reduced"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:IndentationModulusEr
    a owl:Class ;
    rdfs:label "Indentation Modulus Er"@en ;
    rdfs:comment "Reduced modulus corrected for the compliance of the indenter tip (diamond). Sometimes called plane-strain modulus. Units: GPa."@en ;
    skos:altLabel "Er"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:VickersHVIT
    a owl:Class ;
    rdfs:label "Vickers Equivalent Hardness HVIT"@en ;
    rdfs:comment "HIT converted to Vickers scale via the geometric equivalence factor. Dimensionless (HV)."@en ;
    skos:altLabel "HVIT"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

# ── Depth / geometry ────────────────────────────────────────────────────────

dsms:MaximumForceFmax
    a owl:Class ;
    rdfs:label "Maximum Indentation Force Fmax"@en ;
    rdfs:comment "Peak applied force at maximum indentation depth. Units: mN."@en ;
    skos:altLabel "Fmax"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:MaximumDepthhmax
    a owl:Class ;
    rdfs:label "Maximum Indentation Depth hmax"@en ;
    rdfs:comment "Total indentation depth at maximum applied force (elastic + plastic). Units: µm."@en ;
    skos:altLabel "hmax"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:ContactDepthhc
    a owl:Class ;
    rdfs:label "Contact Depth hc"@en ;
    rdfs:comment "Depth of contact between indenter and specimen at maximum force, accounting for pile-up/sink-in (Oliver-Pharr). Units: µm."@en ;
    skos:altLabel "hc"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:ResidualDepthhR
    a owl:Class ;
    rdfs:label "Residual Depth hr"@en ;
    rdfs:comment "Depth of the residual impression after full unloading. Units: µm."@en ;
    skos:altLabel "hr"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:PlasticDepthhp
    a owl:Class ;
    rdfs:label "Plastic Depth hp"@en ;
    rdfs:comment "Irrecoverable (plastic) component of the indentation depth. Units: µm."@en ;
    skos:altLabel "hp"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:ContactStiffnessS
    a owl:Class ;
    rdfs:label "Contact Stiffness S"@en ;
    rdfs:comment "Slope of the unloading curve at maximum depth (dF/dh). Used in the Oliver-Pharr calculation of reduced modulus. Units: mN/µm."@en ;
    skos:altLabel "S"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:ProjectedContactAreaAp
    a owl:Class ;
    rdfs:label "Projected Contact Area Ap"@en ;
    rdfs:comment "Projected area of contact at maximum force, computed from hc via the calibrated tip area function. Units: µm²."@en ;
    skos:altLabel "Ap"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

# ── Work / energy ────────────────────────────────────────────────────────────

dsms:ElasticWorkWelast
    a owl:Class ;
    rdfs:label "Elastic Indentation Work Welast"@en ;
    rdfs:comment "Recoverable (elastic) work done during indentation; area between loading and unloading curves. Units: µJ."@en ;
    skos:altLabel "Welast"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:PlasticWorkWplast
    a owl:Class ;
    rdfs:label "Plastic Indentation Work Wplast"@en ;
    rdfs:comment "Irrecoverable (plastic) work done during indentation. Units: µJ."@en ;
    skos:altLabel "Wplast"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:TotalWorkWtotal
    a owl:Class ;
    rdfs:label "Total Indentation Work Wtotal"@en ;
    rdfs:comment "Total work done during indentation (Welast + Wplast). Units: µJ."@en ;
    skos:altLabel "Wtotal"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

# ── Derived ratios / model parameters ────────────────────────────────────────

dsms:ElasticWorkRatioNIT
    a owl:Class ;
    rdfs:label "Elastic Work Ratio nIT"@en ;
    rdfs:comment "Ratio of elastic to total indentation work: Welast/Wtotal. Dimensionless index of elastic recovery."@en ;
    skos:altLabel "nIT"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:ReverseIndentationRatioRIT
    a owl:Class ;
    rdfs:label "Reverse Indentation Ratio RIT"@en ;
    rdfs:comment "Ratio characterising the reverse deformation behaviour upon unloading. Negative values indicate sink-in; positive values indicate pile-up."@en ;
    skos:altLabel "RIT"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:LoadingExponentM
    a owl:Class ;
    rdfs:label "Loading Exponent m"@en ;
    rdfs:comment "Exponent in the power-law fit F = C·hᵐ to the loading segment (Oliver-Pharr). Ideal value for a conical indenter: 2."@en ;
    skos:altLabel "m"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:GeometryFactorEpsilon
    a owl:Class ;
    rdfs:label "Geometry Factor Epsilon"@en ;
    rdfs:comment "Correction factor ε relating contact depth hc to the measured compliance (≈ 0.75 for Berkovich, ≈ 0.72 for conical)."@en ;
    skos:altLabel "ε"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

dsms:FitQualityR2
    a owl:Class ;
    rdfs:label "Fit Quality R²"@en ;
    rdfs:comment "Coefficient of determination for the power-law fit to the unloading segment. Values close to 1 indicate good fit quality."@en ;
    skos:altLabel "R²"@en ;
    rdfs:subClassOf obo:BFO_0000019 .

# ============================================================================
# Statistical aggregate quality classes (experiment session level)
#
# These are used as rdf:type for quality individuals in the nanoindentation
# experiment summary (characterization/nanoindentation/PMDCo transform).
# They represent aggregate statistics over all valid indentations in a session.
# ============================================================================

dsms:MeanHardnessHIT
    a owl:Class ;
    rdfs:label "Mean Indentation Hardness HIT (session)"@en ;
    rdfs:comment "Arithmetic mean of HIT over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:HardnessHIT .

dsms:StdDevHardnessHIT
    a owl:Class ;
    rdfs:label "Std Dev Indentation Hardness HIT (session)"@en ;
    rdfs:comment "Sample standard deviation of HIT over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:HardnessHIT .

dsms:MeanElasticModulusEIT
    a owl:Class ;
    rdfs:label "Mean Indentation Elastic Modulus EIT (session)"@en ;
    rdfs:comment "Arithmetic mean of EIT over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:ElasticModulusEIT .

dsms:StdDevElasticModulusEIT
    a owl:Class ;
    rdfs:label "Std Dev Indentation Elastic Modulus EIT (session)"@en ;
    rdfs:comment "Sample standard deviation of EIT over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:ElasticModulusEIT .

dsms:MeanIndentationModulusEr
    a owl:Class ;
    rdfs:label "Mean Indentation Modulus Er (session)"@en ;
    rdfs:comment "Arithmetic mean of Er over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:IndentationModulusEr .

dsms:StdDevIndentationModulusEr
    a owl:Class ;
    rdfs:label "Std Dev Indentation Modulus Er (session)"@en ;
    rdfs:comment "Sample standard deviation of Er over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:IndentationModulusEr .

dsms:MeanReducedModulusE
    a owl:Class ;
    rdfs:label "Mean Reduced Modulus E* (session)"@en ;
    rdfs:comment "Arithmetic mean of reduced modulus E* over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:ReducedModulusE .

dsms:StdDevReducedModulusE
    a owl:Class ;
    rdfs:label "Std Dev Reduced Modulus E* (session)"@en ;
    rdfs:comment "Sample standard deviation of E* over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:ReducedModulusE .

dsms:MeanVickersHVIT
    a owl:Class ;
    rdfs:label "Mean Vickers Equivalent HVIT (session)"@en ;
    rdfs:comment "Arithmetic mean of Vickers-equivalent hardness HVIT over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:VickersHVIT .

dsms:StdDevVickersHVIT
    a owl:Class ;
    rdfs:label "Std Dev Vickers Equivalent HVIT (session)"@en ;
    rdfs:comment "Sample standard deviation of HVIT over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:VickersHVIT .

dsms:MeanMaximumDepthhmax
    a owl:Class ;
    rdfs:label "Mean Maximum Depth hmax (session)"@en ;
    rdfs:comment "Arithmetic mean of hmax over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:MaximumDepthhmax .

dsms:StdDevMaximumDepthhmax
    a owl:Class ;
    rdfs:label "Std Dev Maximum Depth hmax (session)"@en ;
    rdfs:comment "Sample standard deviation of hmax over all valid indentations in a nanoindentation session."@en ;
    rdfs:subClassOf dsms:MaximumDepthhmax .

dsms:NumberOfValidIndentations
    a owl:Class ;
    rdfs:label "Number of Valid Indentations"@en ;
    rdfs:comment "Count of indentations in a session that passed all quality criteria (within calibration range, no flagged warnings). Dimensionless integer."@en ;
    rdfs:subClassOf obo:BFO_0000019 .
